{
  "name": "mantine-vite-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc && vp build",
    "build:analyze": "vp build --mode analyze",
    "preview": "vp preview",
    "typecheck": "tsc --noEmit",
    "lint": "npm run oxlint && npm run stylelint",
    "oxlint": "vp lint",
    "stylelint": "stylelint '**/*.css' --cache",
    "format:test": "vp fmt --check",
    "format:write": "vp fmt",
    "vitest": "vp test run",
    "vitest:watch": "vp test",
    "test": "npm run check && npm run stylelint && npm run vitest && npm run build",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "check": "vp check",
    "check:fix": "vp check --fix"
  },
  "dependencies": {
    "@mantine/core": "9.6.2",
    "@mantine/hooks": "9.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@storybook/addon-themes": "^10.0.0",
    "@storybook/react": "^10.0.0",
    "@storybook/react-vite": "^10.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^6.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jsdom": "^30.0.0",
    "oxc-config-mantine": "^1.0.0",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prop-types": "^15.8.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "storybook": "^10.0.0",
    "stylelint": "^17.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "resolutions": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vitest": "5.0.1"
  },
  "packageManager": "yarn@4.18.1"
}
